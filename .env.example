# ==============================================================
# Alpaca Trading API Configuration
# Get your free paper trading keys at https://app.alpaca.markets
# Paper keys start with "PK". Live keys start with "AK" and require
# an approved, funded live account.
# ==============================================================
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Mode: Set to False for Paper Trading (SAFE), True for Live Real Money Trading
ALPACA_LIVE=False

# If your credentials are configured but Alpaca rejects them, the bot REFUSES
# to start rather than silently falling back to the local simulator -- a
# silent fallback trades nothing while looking like it is trading.
# Set this to True only if you deliberately want simulator mode with bad keys.
ALLOW_SIMULATOR_FALLBACK=False

# Assets Watchlist (Comma-separated list of liquid stocks/ETFs)
WATCHLIST=SPY,QQQ,AAPL,NVDA,MSFT,TSLA,AMD

# Timeframe for trading bars: 1Min, 5Min, 15Min, 1Hour, 1Day
BAR_TIMEFRAME=15Min

# Risk Management Settings
MAX_PORTFOLIO_RISK_PER_TRADE=0.015   # Risk 1.5% of total equity per trade
MAX_OPEN_POSITIONS=5                # Max concurrent positions
DAILY_DRAWDOWN_LIMIT=0.03           # Stop trading if equity drops 3% in a single day
PROFIT_TARGET_RR=2.0                # Risk-Reward target: 2x ATR risk for take profit

# Advanced Institutional Risk Controls
MAX_POSITIONS_PER_SECTOR=2          # Cap concurrent positions in the same sector (e.g. max 2 Semis)
ENABLE_EARNINGS_FILTER=True         # Block opening positions within the earnings blackout window
EARNINGS_BLACKOUT_DAYS=2            # Days before/after earnings to halt new entries on a stock
ENABLE_MACRO_TREND_FILTER=True      # Gate 15-min longs when SPY/QQQ are in Daily TRENDING_BEAR
ENABLE_PARTIAL_PROFIT_TAKING=True   # Scale out 50% profit at 1.2R and move stop to Breakeven
SCALE_OUT_RR=1.2                    # Reward-to-Risk ratio to trigger partial profit-taking
SCALE_OUT_PERCENT=0.50              # Tranche percentage to bank at SCALE_OUT_RR

# Self-Improvement & Optimization Settings
ENABLE_SELF_IMPROVEMENT=True        # Automatically run periodic parameter walk-forward optimization
OPTIMIZATION_INTERVAL_HOURS=24      # Retune strategy every 24 hours
OPTIMIZER_SEED=42                   # Makes the parameter search reproducible

# Optimization window and timeframe. These are deliberately separate from
# BAR_TIMEFRAME: live signals can run on 15-minute bars while the parameter
# search runs on 1-hour bars. Alpaca caps 15-minute history at roughly 60
# days, which is too short for the search to produce a trade count worth
# trusting; 1-hour bars reach back years. Tuning on a window too short to
# trade in rejects every candidate forever.
OPTIMIZATION_TIMEFRAME=1Hour        # Timeframe the parameter search reads
OPTIMIZATION_LOOKBACK_DAYS=400      # Window of historical data used to tune parameters

# Optimizer adoption gates.
#
# A new parameter set is adopted only if it clears the floor, has enough
# trades to not be noise, AND beats the parameters already in use by a
# material margin. The margin gate matters because a rolling-origin
# calibration over 311 (symbol, origin) pairs found that a candidate's
# absolute fitness does not predict whether it goes on to work -- the size
# of the improvement over the baseline does.
MIN_FITNESS_TO_ADOPT=0.0            # Absolute floor on out-of-sample fitness
MIN_TRADES_TO_ADOPT=3               # Minimum out-of-sample trades to trust a result
MIN_FITNESS_IMPROVEMENT=0.25        # Required margin over the current parameters

# Notifications (optional). Both are disabled when left blank.
#
# With these set, the bot sends you:
#   - a message on every filled order
#   - a CRITICAL message if the daily drawdown circuit breaker trips
#   - an end-of-session report when the market closes (equity, daily P&L,
#     open positions, trades taken, and anything that went wrong)
#
# The session report fires on the market-close transition, so a bot
# started after hours does not send a bogus report for a session it
# never observed.
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ENABLE_SESSION_REPORT=True
