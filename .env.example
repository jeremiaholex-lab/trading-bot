# ==============================================================
# Alpaca Trading API Configuration
# Get your free paper trading keys at https://app.alpaca.markets
# ==============================================================
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Mode: Set to False for Paper Trading (SAFE), True for Live Real Money Trading
ALPACA_LIVE=False

# Assets Watchlist (Comma-separated list of liquid stocks/ETFs)
WATCHLIST=SPY,QQQ,AAPL,NVDA,MSFT,TSLA,AMD

# Timeframe for trading bars: 1Min, 5Min, 15Min, 1Hour, 1Day
BAR_TIMEFRAME=15Min

# Risk Management Settings
MAX_PORTFOLIO_RISK_PER_TRADE=0.015   # Risk 1.5% of total equity per trade
MAX_OPEN_POSITIONS=5                # Max concurrent positions
DAILY_DRAWDOWN_LIMIT=0.03           # Stop trading if equity drops 3% in a single day
PROFIT_TARGET_RR=2.0                # Risk-Reward target: 2x ATR risk for take profit

# Self-Improvement & Optimization Settings
ENABLE_SELF_IMPROVEMENT=True        # Automatically run periodic parameter walk-forward optimization
OPTIMIZATION_LOOKBACK_DAYS=60       # Window of historical data used to tune parameters
OPTIMIZATION_INTERVAL_HOURS=24      # Retune strategy every 24 hours
